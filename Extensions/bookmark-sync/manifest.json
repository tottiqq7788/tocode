{
  "manifest_version": 3,
  "name": "Tocode 书签同步",
  "version": "1.0.1",
  "description": "将本机书签变更交给 Tocode 同步。",
  "key": "",
  "permissions": [
    "bookmarks",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-sync@tocode.app",
      "strict_min_version": "109.0"
    }
  }
}
